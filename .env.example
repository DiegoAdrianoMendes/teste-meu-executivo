# ── Aplicação ──
APP_ENV=development
APP_NAME="Meu Executivo"
APP_VERSION=0.1.0
# Obrigatórios apenas para `docker compose`; use valores aleatórios URL-safe.
KLM_POSTGRES_USER=klm_migrator
KLM_POSTGRES_PASSWORD=
KLM_APP_DB_PASSWORD=
KLM_REDIS_PASSWORD=
KLM_RUNTIME_MODE=local_simulation
KLM_EXTERNAL_ACTIONS_ENABLED=false
KLM_PRIVATE_AWS_STORAGE_ENABLED=false
KLM_AWS_ENABLED=false
KLM_ADMINISTRATIVE_ACCESS_ENABLED=false
KLM_ONLINE_APPROVED=false
KLM_MODEL_APIS_ENABLED=false
KLM_AI_USAGE_ACCOUNTING_ENABLED=true
KLM_LOCAL_BOOTSTRAP_ENABLED=true
KLM_CHATWOOT_URL=http://127.0.0.1:3100
KLM_ROCKETCHAT_URL=http://127.0.0.1:3200
KLM_OSS_HEALTHCHECK_TIMEOUT_SECONDS=0.6
KLM_CHATWOOT_ACCOUNT_ID=
KLM_CHATWOOT_WEBHOOK_SECRET=
KLM_CHATWOOT_WEBHOOK_MAX_AGE_SECONDS=300
# Somente desenvolvimento local. Produção rejeita este valor conhecido; gere >= 32 bytes aleatórios.
SECRET_KEY=local-development-only-jwt-secret
# Obrigatória em produção: use >= 32 bytes aleatórios e nunca reutilize SECRET_KEY.
# scripts/run_local.py gera e reutiliza uma chave privada em .local; não preencha para uso local.
INTEGRATION_SECRET_ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080
AUTH_REFRESH_COOKIE_NAME=meu_executivo_refresh_token
AUTH_PLATFORM_REFRESH_COOKIE_NAME=meu_executivo_platform_refresh_token
AUTH_REFRESH_COOKIE_PATH=/api/v1/auth
AUTH_REFRESH_COOKIE_DOMAIN=
AUTH_REFRESH_COOKIE_SAMESITE=lax
AUTH_REFRESH_COOKIE_SECURE=false
FRONTEND_URL=http://app.localhost:4173
BLACKBOX_FRONTEND_URL=http://blackbox.localhost:4174
PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://app.localhost:4173,http://blackbox.localhost:4174,http://localhost:5173,http://localhost:4173,http://localhost:4174,http://localhost:8080,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:4173,http://127.0.0.1:4174,http://127.0.0.1:4273,http://127.0.0.1:4274,http://127.0.0.1:8080,http://127.0.0.1:3000

# ── Banco de Dados (PostgreSQL) ──
DATABASE_URL=postgresql+asyncpg://klm_user:klm_password@localhost:5432/klm_legal_hub
DATABASE_URL_SYNC=postgresql://klm_user:klm_password@localhost:5432/klm_legal_hub

# ── Redis ──
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── AWS S3 (Documentos) ──
# Produção usa IAM Task Role/Instance Role. Access keys não pertencem ao .env.
AWS_REGION=us-east-1
S3_BUCKET_NAME=meu-executivo-documents
S3_PUBLIC_ASSET_BUCKET_NAME=meu-executivo-public-assets
S3_PRESIGNED_URL_EXPIRY=3600
S3_PRIVATE_BUCKET_REQUIRED=true
S3_KMS_KEY_ID=
DOCUMENT_AV_MODE=disabled
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_CONNECT_TIMEOUT_SECONDS=5
CLAMAV_SCAN_TIMEOUT_SECONDS=30
DOCUMENT_AV_MAX_BYTES=26214400
DOCUMENT_AV_RETRY_LIMIT=3
LOCAL_STORAGE_MAX_BYTES=26214400
PLATFORM_EXPORT_STORAGE_DIR=.local/platform-exports
PLATFORM_EXPORT_MAX_BYTES=524288000

# ── Cobrança da assinatura do Meu Executivo ──
# Credenciais globais da plataforma. Não reutilizar a chave Asaas operacional
# configurada por cada escritório em app.payments.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
SAAS_ASAAS_ACCESS_TOKEN=
SAAS_ASAAS_WEBHOOK_TOKEN=
SAAS_ASAAS_SANDBOX=true
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

# ── Runtime de modelos API-first ──
# Permanece inerte enquanto KLM_MODEL_APIS_ENABLED e KLM_ONLINE_APPROVED não forem true.
# Habilitar modelos NÃO habilita envio por WhatsApp nem qualquer outra ação externa.
AI_PROVIDER=api_gateway
KLM_LOCAL_MODELS_ENABLED=false
KLM_AI_LEGACY_DIRECT_CALLS_ENABLED=false
KLM_AI_OPENAI_BASE_URL=https://api.openai.com/v1
KLM_AI_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
KLM_AI_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
KLM_AI_ALLOWED_BASE_URLS_JSON='["https://api.openai.com/v1","https://api.anthropic.com/v1","https://generativelanguage.googleapis.com/v1beta"]'
# Configure modelos, rotas e preços somente no onboarding; vazios falham antes de qualquer request.
KLM_AI_MODEL_ALLOWLIST_JSON='[]'
KLM_AI_ROUTE_CATALOG_JSON='{"version":"unconfigured","classes":{},"agents":{}}'
KLM_AI_PRICE_CATALOG_JSON='{"version":"unconfigured","currency":"USD","effective_at":null,"models":{}}'
KLM_AI_AGENT_CALL_CAPS_JSON='{}'
KLM_AI_WORKSPACE_DAILY_BUDGETS_JSON='{}'
KLM_AI_MAX_INPUT_TOKENS_PER_CALL=50000
KLM_AI_MAX_OUTPUT_TOKENS_PER_CALL=4096
KLM_AI_DEFAULT_MAX_OUTPUT_TOKENS=1024
KLM_AI_MAX_COST_PER_CALL_USD=0.50
KLM_AI_WORKSPACE_DAILY_BUDGET_USD=10.00
KLM_AI_HTTP_TIMEOUT_SECONDS=45
KLM_AI_MAX_RETRIES=0
KLM_AI_RETRY_BASE_SECONDS=0.5
KLM_AI_CIRCUIT_FAILURE_THRESHOLD=3
KLM_AI_CIRCUIT_COOLDOWN_SECONDS=60
KLM_AI_CIRCUIT_BACKEND=memory
KLM_AI_BUDGET_BACKEND=memory
KLM_AI_TELEMETRY_BACKEND=logging
KLM_AI_TELEMETRY_STREAM_MAXLEN=100000
KLM_AI_GATEWAY_EVENTS_ENABLED=true
KLM_AI_GATEWAY_EVENTS_RETENTION_DAYS=90
KLM_AI_RESPONSE_CACHE_ENABLED=false
KLM_AI_RESPONSE_CACHE_BACKEND=memory
KLM_AI_RESPONSE_CACHE_TTL_SECONDS=300
KLM_AI_RESPONSE_CACHE_MAX_ENTRIES=1024
KLM_AI_RESPONSE_CACHE_MAX_VALUE_BYTES=1048576
KLM_AI_FAKE_MODEL=klm-fake-v1
KLM_AI_FAKE_SEED=klm-local-fake-v1
KLM_AI_FAKE_RESPONSE_TEXT=Local deterministic simulation.
KLM_AI_FAKE_RESPONSES_JSON='{}'
KLM_LOCAL_REDIS_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.2
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── LangSmith (Observabilidade dos Agentes) ──
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=meu-executivo

# ── Integrações Externas ──
OPENCLAW_WEBHOOK_SECRET=
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ALERTS=#meu-executivo-alertas

# ── WhatsApp Business (Meta Cloud API) ──
# Obtidos em Meta for Developers → App → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=               # System User token permanente (fallback global)
WHATSAPP_PHONE_NUMBER_ID=            # ID do número de telefone
WHATSAPP_BUSINESS_ACCOUNT_ID=        # WhatsApp Business Account ID (WABA ID)
WHATSAPP_VERIFY_TOKEN=             # Gerar valor aleatório no onboarding aprovado
META_GRAPH_API_VERSION=v26.0
# Alias legado aceito somente por um release; prefira META_GRAPH_API_VERSION.
WHATSAPP_API_VERSION=
WHATSAPP_APP_SECRET=                 # App Secret para validar assinatura HMAC do webhook

# ── Meta Embedded Signup (SaaS / Tech Provider) ──
# Necessário para o fluxo de conexão oficial sem copiar credenciais
# Meta for Developers → App → Facebook Login for Business
META_APP_ID=                         # App ID do app Meta da plataforma
META_APP_SECRET=                     # App Secret (pode ser o mesmo que WHATSAPP_APP_SECRET)
META_CONFIG_ID=                      # Configuration ID do Facebook Login for Business
META_SOLUTION_ID=                    # Solution ID da Partner Solution (Tech Providers — opcional)
PLATFORM_META_VERIFY_TOKEN=          # Token de verificação do webhook Messenger/Instagram próprio
PLATFORM_META_PAGE_ACCESS_TOKEN=     # Page access token do Messenger próprio
PLATFORM_META_PAGE_ID=               # Page ID que envia e recebe no Messenger
PLATFORM_INSTAGRAM_ACCESS_TOKEN=     # Token da conta profissional do Instagram próprio
PLATFORM_INSTAGRAM_ACCOUNT_ID=       # Instagram professional account ID
RESEND_API_KEY=                      # API key para envio e leitura de e-mails recebidos
RESEND_WEBHOOK_SECRET=               # Signing secret whsec_... do webhook Resend/Svix
PLATFORM_EMAIL_SALES_ADDRESS=        # Caixa pública de vendas roteada para a Inbox
PLATFORM_EMAIL_SUPPORT_ADDRESS=      # Caixa pública de suporte roteada para a Inbox

# ── ZapSign — Assinatura Eletrônica ──
ZAPSIGN_API_TOKEN=                   # Token da API (obtido em app.zapsign.com.br → Configurações)
ZAPSIGN_WEBHOOK_SECRET=              # Secret para validação opcional do webhook
ZAPSIGN_SANDBOX=false

# ── Vertex AI (Gemini) ──
VERTEX_PROJECT_ID=advocacia-hub
VERTEX_LOCATION=us-central1
VERTEX_MODEL=gemini-2.5-flash-lite
VERTEX_MODEL_PRO=gemini-2.5-pro
GEMMA_ENABLED=false
GEMMA_MODEL_SIMPLE=google/gemma3@gemma-3-4b-it
GEMMA_MODEL_MEDIUM=google/gemma3@gemma-3-27b-it
GEMMA_ENDPOINT_SIMPLE=
GEMMA_ENDPOINT_MEDIUM=

# ── Ollama (opcional: Qwen3 + Gemma 4 local/remoto) ──
# Preservado para desenvolvimento futuro; nunca é selecionado no lançamento API-first.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_DEFAULT=qwen3:14b
OLLAMA_MODEL_SIMPLE=qwen3:4b
OLLAMA_MODEL_MEDIUM=qwen3:14b
OLLAMA_MODEL_COMPLEX=gemma4:12b
OLLAMA_MODEL_PREMIUM=gemma4:12b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_KEEP_ALIVE=10m
OLLAMA_NUM_CTX=8192

# ── Logs ──
LOG_LEVEL=INFO

# ── Frontend (.env do Vite — criar em frontend/.env.local) ──
# Em produção, VITE_API_URL permanece vazio: CloudFront encaminha /api/* e
# /api/v1/ws* à API, preservando cookies host-only por superfície.
# VITE_API_URL=
# VITE_META_APP_ID=         # Mesmo META_APP_ID acima
# VITE_META_CONFIG_ID=      # Mesmo META_CONFIG_ID acima

# ══════════════════════════════════════════════════════════════════════════
# ── Seção AWS Fase 1 (preparação — docs/RUNBOOK_AWS_FASE1.md) ──
# Comentada de propósito: nenhuma variável abaixo deve ser preenchida ou
# descomentada sem decisão explícita do proprietário. Ver explicação completa
# leiga de cada uma em docs/ENV_PRODUCAO_TEMPLATE.md.
# ══════════════════════════════════════════════════════════════════════════

# Gates de produção: sobem SEMPRE false na subida inicial da infra AWS;
# ligar manualmente, um de cada vez, só depois do smoke test (RUNBOOK seção 9).
# KLM_ONLINE_APPROVED=false
# KLM_EXTERNAL_ACTIONS_ENABLED=false
# KLM_PRIVATE_AWS_STORAGE_ENABLED=false
# KLM_AWS_ENABLED=false

# AWS de runtime: usar IAM Task Role, sem chaves estáticas no ambiente.
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=meu-executivo-documents-prod

# Banco de dados de produção (RDS db.t4g.micro — endpoint só existe depois do
# RUNBOOK seção 3; usuários separados migrador/app já usados em docker-compose.prod.yml).
# DATABASE_URL=postgresql+asyncpg://klm_app:<senha>@<endpoint-rds>:5432/klm_legal_hub
# DATABASE_URL_SYNC=postgresql://klm_app:<senha>@<endpoint-rds>:5432/klm_legal_hub

# Criptografia de segredos de conexão por tenant/canal (chave usada pelo backend
# para cifrar tokens de integração — WhatsApp BYOA, ZapSign, etc. — antes de
# gravar no banco). GAP CONHECIDO: esta chave não existe hoje neste repositório
# como variável nomeada (nem em app/core/config.py, nem em .env.example antes
# desta seção); a variável ativa hoje é INTEGRATION_SECRET_ENCRYPTION_KEY (acima).
# Se um trabalho futuro introduzir rotação de chaves por-conexão (ver
# docs/PLANO_META_MAXIMO_2026-07-23.md, "app secret por conexão" no modo B1),
# o nome de variável esperado é WHATSAPP_SECRET_ENCRYPTION_KEYS (plural, JSON de
# lista, para suportar rotação sem downtime) — registrar aqui quando existir.
# WHATSAPP_SECRET_ENCRYPTION_KEYS=

# Catálogo de roteamento de IA (escada SIMPLE/MEDIUM/COMPLEX/PREMIUM) — exemplo
# PREENCHIDO conforme docs/PRICING_BILLING_POLITICA_2026-07.md seção sobre custo
# por classe. NÃO usar em produção sem revisão: nomes de modelo/preço mudam;
# confirmar contra a tabela de preços vigente do provedor antes de ativar.
# Continua inerte enquanto KLM_MODEL_APIS_ENABLED/KLM_ONLINE_APPROVED forem false.
# KLM_AI_ROUTE_CATALOG_JSON='{"version":"2026-07-exemplo","classes":{"SIMPLE":{"agents":["sdr","crm","secretaria","qualificacao","insights","transcricao"]},"MEDIUM":{"agents":["copiloto","closer","paralegal"]},"COMPLEX":{"agents":["juridico","multimodal"]},"PREMIUM":{"agents":["peticao","klm_drafter"]}},"agents":{"sdr":{"class":"SIMPLE","model":"gpt-4o-mini"},"crm":{"class":"SIMPLE","model":"gpt-4o-mini"},"secretaria":{"class":"SIMPLE","model":"gpt-4o-mini"},"qualificacao":{"class":"SIMPLE","model":"gpt-4o-mini"},"insights":{"class":"SIMPLE","model":"gpt-4o-mini"},"transcricao":{"class":"SIMPLE","model":"gpt-4o-mini"},"copiloto":{"class":"MEDIUM","model":"gemini-2.5-flash"},"closer":{"class":"MEDIUM","model":"gemini-2.5-flash"},"paralegal":{"class":"MEDIUM","model":"gemini-2.5-flash"},"juridico":{"class":"COMPLEX","model":"claude-sonnet-4-5"},"multimodal":{"class":"COMPLEX","model":"gemini-2.5-pro"},"peticao":{"class":"PREMIUM","model":"claude-opus-4-1"},"klm_drafter":{"class":"PREMIUM","model":"claude-opus-4-1"}}}'

# Budgets diários por workspace (USD) e caps de chamada por agente — mesmo
# formato JSON das variáveis KLM_AI_* já existentes acima; exemplo de referência,
# não de valor final:
# KLM_AI_WORKSPACE_DAILY_BUDGETS_JSON='{"default":10.00}'
# KLM_AI_AGENT_CALL_CAPS_JSON='{"peticao":{"max_calls_per_day":50}}'

# Datasets CAPI (Conversions API) por workspace — Fase 2 do plano (T3), preparar
# nomenclatura agora para não precisar migrar depois:
# CAPI_DATASET_ID_DEFAULT=
# CAPI_ACCESS_TOKEN=
# CAPI_TEST_EVENT_CODE=

# Monitoramento processual (módulo contratável). Gates SEPARADOS por fonte:
# abrir um não abre o outro. Ambos são adicionais a KLM_EXTERNAL_ACTIONS_ENABLED.
# KLM_DATAJUD_LIVE_ENABLED=true sem DATAJUD_API_KEY é recusado na subida.
KLM_DJEN_LIVE_ENABLED=false
KLM_DATAJUD_LIVE_ENABLED=false
DATAJUD_API_KEY=

+// KLM's signed, single-use launch exchanges its server-side JWTs for this
+// short-lived bootstrap cookie. BottleCRM already stores these values in
+// localStorage for browser-side CRUD, so hydrate the established contract and
+// immediately delete the transfer cookie.
+if (typeof document !== 'undefined') {
+  const entry = document.cookie
+    .split('; ')
+    .find((item) => item.startsWith('klm_bottle_bootstrap='));
+  if (entry) {
+    try {
+      const raw = entry.slice('klm_bottle_bootstrap='.length);
+      const normalized = raw.replace(/-/g, '+').replace(/_/g, '/');
+      const padding = '='.repeat((4 - (normalized.length % 4)) % 4);
+      const payload = JSON.parse(atob(normalized + padding));
+      localStorage.setItem(STORAGE_KEYS.ACCESS_TOKEN, payload.access_token);
+      localStorage.setItem(STORAGE_KEYS.REFRESH_TOKEN, payload.refresh_token);
+      localStorage.setItem(STORAGE_KEYS.ORG_ID, payload.org_id);
+    } catch (error) {
+      console.error('BottleCRM local session bootstrap failed:', error);
+    } finally {
+      document.cookie = 'klm_bottle_bootstrap=; Max-Age=0; Path=/; SameSite=Strict';
+    }
+  }

# syntax=docker/dockerfile:1.7

FROM python:3.12-slim-bookworm

ARG BOTTLECRM_COMMIT=3ab79d75ece005a414d9d3ef729b7240545d1b41

LABEL org.opencontainers.image.title="BottleCRM public backend (KLM local overlay)" \
      org.opencontainers.image.revision="${BOTTLECRM_COMMIT}" \
      org.opencontainers.image.source="https://github.com/MicroPyramid/BottleCRM" \
      org.opencontainers.image.licenses="MIT"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:$PATH" \
    PORT=8000

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates \
        curl \
        libcairo2 \
        libffi-dev \
        libgdk-pixbuf2.0-0 \
        libpango-1.0-0 \
        libpangocairo-1.0-0 \
        libpq5 \
        patch \
        shared-mime-info \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.11 /uv /usr/local/bin/uv

WORKDIR /app

COPY .vendor/upstreams/bottlecrm/backend/pyproject.toml ./pyproject.toml
COPY .vendor/upstreams/bottlecrm/backend/uv.lock ./uv.lock
COPY .vendor/upstreams/bottlecrm/backend/.python-version ./.python-version
RUN uv sync --frozen --no-install-project

COPY .vendor/upstreams/bottlecrm/backend/ ./
COPY docker/oss/bottlecrm/backend/klm_local_auth.py /app/common/views/klm_local_auth.py
COPY docker/oss/bottlecrm/backend/local-runtime.patch /opt/bottlecrm/local-runtime.patch
COPY docker/oss/bottlecrm/backend/api-contract.patch /opt/bottlecrm/api-contract.patch
RUN patch --batch --forward --strip=1 --directory=/app < /opt/bottlecrm/local-runtime.patch \
    && patch --batch --forward --strip=1 --directory=/app < /opt/bottlecrm/api-contract.patch \
    && rm /opt/bottlecrm/local-runtime.patch /opt/bottlecrm/api-contract.patch

COPY docker/oss/bottlecrm/backend/bootstrap_org.py /opt/bottlecrm/bootstrap_org.py
COPY docker/oss/bottlecrm/backend/entrypoint.sh /usr/local/bin/bottlecrm-entrypoint

RUN groupadd --gid 10002 bottlecrm \
    && useradd --uid 10002 --gid 10002 --no-create-home --home-dir /app bottlecrm \
    && mkdir -p /app/media /app/staticfiles \
    && chmod 0555 /usr/local/bin/bottlecrm-entrypoint /opt/bottlecrm/bootstrap_org.py \
    && chown -R bottlecrm:bottlecrm /app

USER 10002:10002

EXPOSE 8000

ENTRYPOINT ["/usr/local/bin/bottlecrm-entrypoint"]
CMD ["api"]

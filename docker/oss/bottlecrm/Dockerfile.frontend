# syntax=docker/dockerfile:1.7

FROM node:22-bookworm-slim AS builder

ARG BOTTLECRM_COMMIT=3ab79d75ece005a414d9d3ef729b7240545d1b41

ENV CI=true \
    NPM_CONFIG_AUDIT=false \
    NPM_CONFIG_FUND=false

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@10.12.1 --activate
RUN apt-get update \
    && apt-get install --yes --no-install-recommends patch \
    && rm -rf /var/lib/apt/lists/*

COPY .vendor/upstreams/bottlecrm/frontend/package.json ./package.json
COPY .vendor/upstreams/bottlecrm/frontend/pnpm-lock.yaml ./pnpm-lock.yaml
COPY docker/oss/bottlecrm/frontend/lockfile-overrides.patch /opt/bottlecrm/lockfile-overrides.patch
RUN patch --batch --forward --strip=1 < /opt/bottlecrm/lockfile-overrides.patch
RUN pnpm install --frozen-lockfile

COPY .vendor/upstreams/bottlecrm/frontend/ ./
COPY docker/oss/bottlecrm/frontend/local-runtime.patch /opt/bottlecrm/local-runtime.patch
RUN patch --batch --forward --strip=1 < /opt/bottlecrm/local-runtime.patch \
    && pnpm check \
    && pnpm build

FROM node:22-bookworm-slim

ARG BOTTLECRM_COMMIT=3ab79d75ece005a414d9d3ef729b7240545d1b41

LABEL org.opencontainers.image.title="BottleCRM public frontend (KLM local overlay)" \
      org.opencontainers.image.revision="${BOTTLECRM_COMMIT}" \
      org.opencontainers.image.source="https://github.com/MicroPyramid/BottleCRM" \
      org.opencontainers.image.licenses="MIT"

ENV HOST=0.0.0.0 \
    PORT=3000 \
    NODE_ENV=development

WORKDIR /app

COPY --from=builder /app/build ./build
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json

RUN groupadd --gid 10003 bottlecrm-web \
    && useradd --uid 10003 --gid 10003 --no-create-home --home-dir /app bottlecrm-web \
    && chown -R bottlecrm-web:bottlecrm-web /app

USER 10003:10003

EXPOSE 3000

CMD ["node", "build"]

# syntax=docker/dockerfile:1.7

ARG PYTHON_IMAGE=python:3.12-slim-bookworm

FROM ${PYTHON_IMAGE} AS wheels

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /build

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        build-essential \
        libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY .vendor/upstreams/chattermate/backend/requirements.txt ./requirements.txt

RUN python -m pip wheel --wheel-dir /wheels --requirement requirements.txt


FROM ${PYTHON_IMAGE} AS runtime

ARG CHATTERMATE_VERSION=1.0.14
ARG CHATTERMATE_COMMIT=9770df5b4d4909084a3b3a00ff2404d25724de90

LABEL org.opencontainers.image.title="ChatterMate public backend (KLM local overlay)" \
      org.opencontainers.image.version="${CHATTERMATE_VERSION}" \
      org.opencontainers.image.revision="${CHATTERMATE_COMMIT}" \
      org.opencontainers.image.source="https://github.com/chattermate/chattermate.chat" \
      org.opencontainers.image.licenses="Apache-2.0"

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    PORT=8000 \
    TOKENIZERS_PARALLELISM=false \
    HF_HOME=/app/.cache/huggingface \
    HF_HUB_CACHE=/app/.cache/huggingface/hub \
    HF_HUB_DISABLE_TELEMETRY=1 \
    SENTENCE_TRANSFORMERS_HOME=/app/.cache/huggingface/sentence_transformers \
    TORCH_HOME=/app/.cache/torch \
    XDG_CACHE_HOME=/app/.cache \
    PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright

WORKDIR /app

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates \
        curl \
        libgl1 \
        libglib2.0-0 \
        libgomp1 \
        libpq5 \
        patch \
    && rm -rf /var/lib/apt/lists/*

COPY --from=wheels /wheels /wheels
COPY .vendor/upstreams/chattermate/backend/requirements.txt ./requirements.txt
RUN python -m pip install --no-index --find-links=/wheels --requirement requirements.txt \
    && rm -rf /wheels

# Crawl4AI's browser is installed at image-build time. Embedding models are
# deliberately not preloaded here or from the runtime entrypoint.
RUN crawl4ai-setup

# The runtime is read-only. Route libraries that rely on HOME—including
# Crawl4AI's SQLite cache and browser profiles—to the explicit config volume.
ENV HOME=/app/config \
    CRAWL4_AI_BASE_DIRECTORY=/app/config

COPY .vendor/upstreams/chattermate/backend/app ./app
COPY .vendor/upstreams/chattermate/backend/alembic ./alembic
COPY .vendor/upstreams/chattermate/backend/alembic.ini ./alembic.ini
COPY .vendor/upstreams/chattermate/backend/assets ./assets
COPY .vendor/upstreams/chattermate/backend/scripts ./upstream-scripts
COPY docker/oss/chattermate/backend/local-runtime.patch /opt/chattermate/local-runtime.patch

# Defense in depth: Dockerfile.backend.dockerignore already excludes the
# uninitialized/private enterprise gitlink. Never retain it if a local checkout
# happens to have initialized that submodule.
RUN patch --batch --forward --strip=1 --directory=/app/app \
        < /opt/chattermate/local-runtime.patch \
    && rm /opt/chattermate/local-runtime.patch \
    && rm -rf /app/app/enterprise

COPY docker/oss/chattermate/backend/entrypoint.sh /usr/local/bin/chattermate-entrypoint
COPY docker/oss/chattermate/backend/runtime_preflight.py /opt/chattermate/runtime_preflight.py

RUN groupadd --gid 10001 chattermate \
    && useradd --uid 10001 --gid 10001 --no-create-home --home-dir /app/config chattermate \
    && mkdir -p \
        /app/.cache/huggingface/hub \
        /app/.cache/huggingface/sentence_transformers \
        /app/.cache/torch \
        /app/config \
        /app/temp \
        /app/uploads/agents \
    && chmod 0555 /usr/local/bin/chattermate-entrypoint /opt/chattermate/runtime_preflight.py \
    && chown -R chattermate:chattermate \
        /app/.cache \
        /app/config \
        /app/temp \
        /app/uploads \
        /opt/ms-playwright

USER 10001:10001

EXPOSE 8000

ENTRYPOINT ["/usr/local/bin/chattermate-entrypoint"]
CMD ["api"]

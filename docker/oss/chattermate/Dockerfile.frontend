# syntax=docker/dockerfile:1.7

ARG NODE_IMAGE=node:22-bookworm-slim

FROM ${NODE_IMAGE} AS builder

ARG CHATTERMATE_VERSION=1.0.14
ARG CHATTERMATE_COMMIT=9770df5b4d4909084a3b3a00ff2404d25724de90

ENV CI=true \
    NODE_ENV=production \
    NPM_CONFIG_AUDIT=false \
    NPM_CONFIG_FUND=false \
    VITE_API_URL=/api/v1

WORKDIR /src/frontend

RUN apt-get update \
    && apt-get install --yes --no-install-recommends patch \
    && rm -rf /var/lib/apt/lists/*

COPY .vendor/upstreams/chattermate/frontend/package.json ./package.json
COPY .vendor/upstreams/chattermate/frontend/package-lock.json ./package-lock.json
# v1.0.14's npm lock contains stale optional-peer metadata for picomatch.
# Keep the lock authoritative while asking npm not to re-resolve peer edges.
RUN npm ci --legacy-peer-deps --include=dev

COPY .vendor/upstreams/chattermate/frontend/ ./
COPY docker/oss/chattermate/frontend/local-runtime.patch /opt/chattermate-overlay/local-runtime.patch
COPY docker/oss/chattermate/frontend/build.sh /opt/chattermate-overlay/build.sh

RUN /bin/sh /opt/chattermate-overlay/build.sh


FROM nginx:1.29.5-alpine AS runtime

ARG CHATTERMATE_VERSION=1.0.14
ARG CHATTERMATE_COMMIT=9770df5b4d4909084a3b3a00ff2404d25724de90

LABEL org.opencontainers.image.title="ChatterMate public frontend (KLM local overlay)" \
      org.opencontainers.image.version="${CHATTERMATE_VERSION}" \
      org.opencontainers.image.revision="${CHATTERMATE_COMMIT}" \
      org.opencontainers.image.source="https://github.com/chattermate/chattermate.chat" \
      org.opencontainers.image.licenses="Apache-2.0"

RUN apk add --no-cache jq \
    && rm -rf /usr/share/nginx/html/* /etc/nginx/conf.d/*

COPY --from=builder /src/frontend/dist/ /usr/share/nginx/html/
COPY docker/oss/chattermate/frontend/nginx.conf /etc/nginx/nginx.conf
COPY docker/oss/chattermate/frontend/entrypoint.sh /usr/local/bin/chattermate-frontend-entrypoint

RUN chmod 0555 /usr/local/bin/chattermate-frontend-entrypoint \
    && chown -R 101:101 /usr/share/nginx/html

USER 101:101

EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/chattermate-frontend-entrypoint"]
CMD ["nginx", "-g", "daemon off;"]

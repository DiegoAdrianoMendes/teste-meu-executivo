# syntax=docker/dockerfile:1.7

FROM nginx:1.29.5-alpine

ARG CHATTERMATE_VERSION=1.0.14
ARG CHATTERMATE_COMMIT=9770df5b4d4909084a3b3a00ff2404d25724de90

LABEL org.opencontainers.image.title="ChatterMate same-origin gateway (KLM local overlay)" \
      org.opencontainers.image.version="${CHATTERMATE_VERSION}" \
      org.opencontainers.image.revision="${CHATTERMATE_COMMIT}" \
      org.opencontainers.image.source="https://github.com/chattermate/chattermate.chat" \
      org.opencontainers.image.licenses="Apache-2.0"

RUN rm -rf /etc/nginx/conf.d/*

COPY docker/oss/chattermate/gateway/nginx.conf /etc/nginx/nginx.conf

USER 101:101

EXPOSE 8080

ENTRYPOINT ["nginx"]
CMD ["-g", "daemon off;"]

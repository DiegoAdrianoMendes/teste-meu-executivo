# Static rendering sentinels only. These values intentionally fail the backend
# preflight and must never be used to start ChatterMate.
KLM_OSS_CHATTERMATE_PORT=3300
KLM_OSS_CHATTERMATE_START_TIMEOUT=300
KLM_OSS_CHATTERMATE_TIMEZONE=America/Sao_Paulo

KLM_OSS_CHATTERMATE_POSTGRES_PASSWORD=not-a-secret-run-start-script
KLM_OSS_CHATTERMATE_REDIS_PASSWORD=not-a-secret-run-start-script
KLM_OSS_CHATTERMATE_JWT_SECRET=not-a-secret-run-start-script
KLM_OSS_CHATTERMATE_CONVERSATION_SECRET=not-a-secret-run-start-script
KLM_OSS_CHATTERMATE_ENCRYPTION_KEY=not-a-secret-run-start-script

# Optional public browser configuration. Leave blank unless the corresponding
# self-hosted feature is configured.
KLM_OSS_CHATTERMATE_FIREBASE_API_KEY=
KLM_OSS_CHATTERMATE_FIREBASE_AUTH_DOMAIN=
KLM_OSS_CHATTERMATE_FIREBASE_PROJECT_ID=
KLM_OSS_CHATTERMATE_FIREBASE_MESSAGING_SENDER_ID=
KLM_OSS_CHATTERMATE_FIREBASE_APP_ID=
KLM_OSS_CHATTERMATE_FIREBASE_STORAGE_BUCKET=
KLM_OSS_CHATTERMATE_FIREBASE_MEASUREMENT_ID=
KLM_OSS_CHATTERMATE_FIREBASE_VAPID_KEY=
KLM_OSS_CHATTERMATE_GOOGLE_FONTS_API_KEY=
KLM_OSS_CHATTERMATE_SHOPIFY_API_KEY=

# Optional server-side integrations. No provider is enabled by this example.
KLM_OSS_CHATTERMATE_FIREBASE_CREDENTIALS=
KLM_OSS_CHATTERMATE_JIRA_CLIENT_ID=
KLM_OSS_CHATTERMATE_JIRA_CLIENT_SECRET=
KLM_OSS_CHATTERMATE_META_APP_ID=
KLM_OSS_CHATTERMATE_META_APP_SECRET=
KLM_OSS_CHATTERMATE_META_WEBHOOK_VERIFY_TOKEN=
KLM_OSS_CHATTERMATE_SHOPIFY_API_SECRET=
KLM_OSS_CHATTERMATE_SLACK_CLIENT_ID=
KLM_OSS_CHATTERMATE_SLACK_CLIENT_SECRET=
KLM_OSS_CHATTERMATE_SLACK_SIGNING_SECRET=

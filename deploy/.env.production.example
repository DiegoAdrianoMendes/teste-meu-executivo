# Meu Executivo V1 — nomes das variáveis de produção.
#
# Este arquivo não é carregado diretamente em produção. Os valores reais devem
# residir no AWS Secrets Manager/SSM e chegar às tasks por IAM Role. Nunca copie
# segredos para o repositório, user-data, imagem Docker ou GitHub Actions.

APP_ENV=production
APP_NAME=Meu Executivo
APP_VERSION=1.0.0
DEBUG=false
KLM_RUNTIME_MODE=production
KLM_LOCAL_BOOTSTRAP_ENABLED=false

# Segredos gerados e armazenados no Secrets Manager.
SECRET_KEY=
INTEGRATION_SECRET_ENCRYPTION_KEY=

# Sessões isoladas por hostname.
AUTH_REFRESH_COOKIE_NAME=meu_executivo_refresh_token
AUTH_PLATFORM_REFRESH_COOKIE_NAME=meu_executivo_platform_refresh_token
AUTH_REFRESH_COOKIE_PATH=/api/v1/auth
AUTH_REFRESH_COOKIE_DOMAIN=
AUTH_REFRESH_COOKIE_SAMESITE=lax
AUTH_REFRESH_COOKIE_SECURE=true
FRONTEND_URL=https://app.meuexecutivo.com
BLACKBOX_FRONTEND_URL=https://blackbox.meuexecutivo.com
PUBLIC_API_URL=https://api.meuexecutivo.com
CORS_ORIGINS=https://app.meuexecutivo.com,https://blackbox.meuexecutivo.com

# RDS. Migração e runtime usam usuários distintos.
DATABASE_MIGRATOR_URL=
DATABASE_MIGRATOR_URL_SYNC=
DATABASE_URL=
DATABASE_URL_SYNC=

# ElastiCache/Redis com trânsito criptografado quando suportado pelo cluster.
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# AWS usa a IAM Task Role; não existem access keys neste contrato.
AWS_REGION=us-east-1
S3_BUCKET_NAME=
S3_PRIVATE_BUCKET_REQUIRED=true
S3_PRESIGNED_URL_EXPIRY=900

# Gates sobem fechados. A V1 pode ser validada sem executar efeitos externos.
KLM_ONLINE_APPROVED=false
KLM_EXTERNAL_ACTIONS_ENABLED=false
KLM_AWS_ENABLED=false
KLM_MODEL_APIS_ENABLED=false
KLM_AI_USAGE_ACCOUNTING_ENABLED=true
KLM_AI_BUDGET_BACKEND=redis
KLM_AI_TELEMETRY_BACKEND=redis
KLM_AI_CIRCUIT_BACKEND=redis
KLM_AI_RESPONSE_CACHE_BACKEND=redis

# Integrações continuam vazias até a configuração oficial de cada provedor.
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
META_SOLUTION_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Cobrança global do SaaS. O Asaas operacional dos escritórios permanece
# isolado em credenciais tenant e não usa estas variáveis.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
SAAS_ASAAS_ACCESS_TOKEN=
SAAS_ASAAS_WEBHOOK_TOKEN=
SAAS_ASAAS_SANDBOX=false
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

LOG_LEVEL=INFO

# Monitoramento processual (módulo contratável). Gates SEPARADOS por fonte:
# abrir um não abre o outro. Ambos são adicionais a KLM_EXTERNAL_ACTIONS_ENABLED.
# KLM_DATAJUD_LIVE_ENABLED=true sem DATAJUD_API_KEY é recusado na subida.
KLM_DJEN_LIVE_ENABLED=false
KLM_DATAJUD_LIVE_ENABLED=false
DATAJUD_API_KEY=
# O DJEN responde 403 a IPs fora do Brasil. Com o ARN de uma Lambda em sa-east-1
# (deploy/lambda/cnj_relay) as consultas ao DJEN e ao DataJud saem de São Paulo;
# vazio, saem direto do worker. Não abre gate nenhum.
KLM_CNJ_RELAY_FUNCTION_ARN=

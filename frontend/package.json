{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "verify:node": "node scripts/verify-node-version.mjs",
    "verify:blackbox-ux": "node scripts/verify-blackbox-no-internal-ids.mjs",
    "predev": "npm run verify:node",
    "dev": "vite",
    "dev:app": "VITE_APP_SURFACE=workspace vite --host 0.0.0.0 --port 4173",
    "dev:blackbox": "VITE_APP_SURFACE=platform vite --host 0.0.0.0 --port 4174",
    "prebuild": "npm run verify:node",
    "build": "vite build",
    "build:app": "VITE_APP_SURFACE=workspace vite build --outDir dist-app && npm run verify:bundle:app",
    "build:blackbox": "VITE_APP_SURFACE=platform vite build --outDir dist-blackbox && npm run verify:bundle:blackbox",
    "build:staging:app": "VITE_APP_SURFACE=workspace VITE_API_URL=https://staging-api.meuexecutivo.com VITE_META_GRAPH_API_VERSION=v26.0 vite build --outDir dist-app && EXPECTED_API_ORIGIN=https://staging-api.meuexecutivo.com node scripts/verify-production-bundle.mjs dist-app",
    "build:staging:blackbox": "VITE_APP_SURFACE=platform VITE_API_URL=https://staging-api.meuexecutivo.com VITE_META_GRAPH_API_VERSION=v26.0 vite build --outDir dist-blackbox && EXPECTED_API_ORIGIN=https://staging-api.meuexecutivo.com node scripts/verify-production-bundle.mjs dist-blackbox",
    "verify:bundle:app": "node scripts/verify-production-bundle.mjs dist-app",
    "verify:bundle:blackbox": "node scripts/verify-production-bundle.mjs dist-blackbox",
    "postbuild": "node scripts/verify-production-bundle.mjs",
    "verify:production": "npm run build",
    "prebuild:dev": "npm run verify:node",
    "build:dev": "vite build --mode development",
    "lint": "node --no-experimental-require-module ./node_modules/eslint/bin/eslint.js src e2e scripts vite.config.ts vitest.config.ts && npm run verify:blackbox-ux",
    "pretypecheck": "npm run verify:node",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "preview": "vite preview",
    "pretest": "npm run verify:node",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:e2e": "npm run verify:node",
    "test:e2e": "playwright test"
  },
